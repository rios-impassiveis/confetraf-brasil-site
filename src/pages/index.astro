---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Card from "@components/Card";
import Datetime from "@components/Datetime";
import { SITE } from "@config";
import { withBase } from "@utils/getPath";
import { slugifyStr } from "@utils/slugify";
import getPosts from "@utils/getPosts";
import getSortedPosts from "@utils/getSortedPosts";
import getDocuments from "@utils/getDocuments";

const posts = await getPosts();
const sortedPosts = getSortedPosts(posts);

const featuredPost = sortedPosts.find(({ data }) => data.featured);
const recentPosts = sortedPosts
  .filter(post => post.slug !== featuredPost?.slug)
  .slice(0, 4);

const documents = (await getDocuments())
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout>
  <Header activeNav="inicio" />
  <main id="main-content">
    <div class="hero-band">
      <div class="hero-inner">
        <h1>{SITE.title}</h1>
        <p class="hero-desc">{SITE.desc}</p>
        <div class="hero-actions">
          <LinkButton
            href={withBase("/confederacao/")}
            className="btn btn-primary"
          >
            Conheça a Confederação
          </LinkButton>
          <LinkButton href={withBase("/posts/")} className="btn btn-outline">
            Ver notícias
          </LinkButton>
        </div>
      </div>
    </div>

    {
      featuredPost && (
        <section id="featured" aria-labelledby="featured-heading">
          <h2 id="featured-heading">Notícia em destaque</h2>
          <a
            href={withBase(`/posts/${featuredPost.slug}/`)}
            class="featured-card"
          >
            <h3 transition:name={slugifyStr(featuredPost.data.title)}>
              {featuredPost.data.title}
            </h3>
            <Datetime
              pubDatetime={featuredPost.data.pubDatetime}
              modDatetime={featuredPost.data.modDatetime}
            />
            <p>{featuredPost.data.description}</p>
          </a>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" aria-labelledby="recent-heading">
          <h2 id="recent-heading">Notícias recentes</h2>
          <ul>
            {recentPosts.map(({ data, slug }) => (
              <Card
                href={withBase(`/posts/${slug}/`)}
                frontmatter={data}
                secHeading={false}
              />
            ))}
          </ul>
          <div class="section-cta">
            <LinkButton href={withBase("/posts/")} className="btn btn-outline">
              Ver todas as notícias
            </LinkButton>
          </div>
        </section>
      )
    }

    <section id="institucional" aria-labelledby="institucional-heading">
      <h2 id="institucional-heading">A Confederação</h2>
      <p>
        A CONFETRAF-BRASIL reúne federações e organizações sindicais que
        representam trabalhadoras e trabalhadores da agricultura familiar em
        todo o Brasil.
      </p>
      <LinkButton href={withBase("/confederacao/")} className="btn btn-outline">
        Saiba mais
      </LinkButton>
    </section>

    <section id="organizacao" aria-labelledby="organizacao-heading">
      <h2 id="organizacao-heading">Organização territorial</h2>
      <p>
        Conheça as federações e sindicatos filiados, e a presença da
        CONFETRAF-BRASIL nos territórios.
      </p>
      <LinkButton href={withBase("/organizacao/")} className="btn btn-outline">
        Ver organização
      </LinkButton>
    </section>

    {
      documents.length > 0 && (
        <section id="documentos" aria-labelledby="documentos-heading">
          <h2 id="documentos-heading">Documentos</h2>
          <ul class="document-list">
            {documents.map(({ data }) => (
              <li>
                <a href={withBase(data.file)}>{data.title}</a>
                <span class="document-category">{data.category}</span>
              </li>
            ))}
          </ul>
          <div class="section-cta">
            <LinkButton
              href={withBase("/documentos/")}
              className="btn btn-outline"
            >
              Ver todos os documentos
            </LinkButton>
          </div>
        </section>
      )
    }

    <div class="contact-band">
      <div class="contact-inner">
        <h2>Fale com a CONFETRAF-BRASIL</h2>
        <LinkButton href={withBase("/contato/")} className="btn btn-primary">
          Entrar em contato
        </LinkButton>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .hero-band {
    @apply mb-8 bg-skin-card;
  }
  .hero-inner {
    @apply mx-auto max-w-3xl px-4 py-12 sm:py-16;
  }
  .hero-inner h1 {
    @apply text-3xl font-bold sm:text-5xl;
  }
  .hero-desc {
    @apply mt-4 max-w-2xl text-lg opacity-90;
  }
  .hero-actions {
    @apply mt-6 flex flex-wrap gap-3;
  }

  .btn {
    @apply inline-block rounded px-5 py-2.5 font-medium no-underline transition-colors;
  }
  .btn-primary {
    @apply bg-skin-accent text-skin-inverted hover:opacity-90 hover:!text-skin-inverted;
  }
  .btn-outline {
    @apply border border-skin-line text-skin-base hover:border-skin-accent hover:text-skin-accent;
  }

  #featured,
  #recent-posts,
  #institucional,
  #organizacao,
  #documentos {
    @apply pb-6 pt-10;
  }
  #featured h2,
  #recent-posts h2,
  #institucional h2,
  #organizacao h2,
  #documentos h2 {
    @apply mb-4 text-2xl font-semibold tracking-wide;
  }
  #institucional p,
  #organizacao p {
    @apply mb-4 max-w-2xl;
  }

  .featured-card {
    @apply block rounded border border-skin-line bg-skin-card p-5 no-underline hover:border-skin-accent;
  }
  .featured-card h3 {
    @apply text-xl font-medium text-skin-accent;
  }
  .featured-card p {
    @apply mt-2 text-skin-base;
  }

  .section-cta {
    @apply mt-4;
  }

  .document-list {
    @apply space-y-2;
  }
  .document-list li {
    @apply flex flex-wrap items-baseline gap-2;
  }
  .document-list a {
    @apply font-medium text-skin-accent underline-offset-4 hover:underline;
  }
  .document-category {
    @apply text-sm opacity-70;
  }

  .contact-band {
    @apply mt-12 bg-skin-card;
  }
  .contact-inner {
    @apply mx-auto flex max-w-3xl flex-col items-start gap-4 px-4 py-10 sm:flex-row sm:items-center sm:justify-between;
  }
  .contact-inner h2 {
    @apply text-xl font-semibold;
  }
</style>
