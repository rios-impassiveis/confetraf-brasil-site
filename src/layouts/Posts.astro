---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { SITE } from "@config";
import { withBase } from "@utils/getPath";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`Notícias | ${SITE.title}`}>
  <Header activeNav="noticias" />
  <Main
    pageTitle="Notícias"
    pageDesc="Todas as notícias publicadas pela CONFETRAF-BRASIL."
  >
    {
      paginatedPosts.length === 0 ? (
        <p>Nenhuma notícia publicada no momento.</p>
      ) : (
        <ul>
          {paginatedPosts.map(({ data, slug }) => (
            <Card href={withBase(`/posts/${slug}/`)} frontmatter={data} />
          ))}
        </ul>
      )
    }
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={withBase(
      `/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`
    )}
    nextUrl={withBase(`/posts/${currentPage + 1}/`)}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
